# Optional, local development only: lets syllabus import work without
# entering a key in the app. Production builds ignore it, so a deployed site
# always uses each visitor's own key. Get a key at https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Canvas tokens are entered on the login page and kept in the browser;
# the server never reads one from the environment.
